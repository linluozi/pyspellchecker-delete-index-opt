+    def _get_delete_index(self) -> dict[str, str | list[str]]:
+        """Return the "delete variant" reverse index, building it on first use.
+
+        Every dictionary word is indexed under itself and under each of the strings
+        obtained by removing exactly one of its characters. Looking a string up in
+        this index therefore answers "which dictionary words are within one
+        insertion of this string?" in O(1) instead of generating and testing the
+        whole edit distance one neighbourhood.
+
+        A bucket holds a single string while only one word maps to it and only grows
+        into a list when a second word does; that keeps the index at roughly half the
+        memory of storing a list per entry.
+
+        Returns:
+            dict: mapping of a delete variant to the dictionary word(s) that produced it
+        Note:
+            The index is cached; it is dropped whenever the dictionary is modified."""
+        index = self._delete_index
+        if index is not None:
+            return index
+        index: dict[str, str | list[str]] = {}
+        get = index.get
+        for word in self._dictionary:
+            # zero deletions: `word` itself, so that a query equal to `word` finds it
+            bucket = get(word)
+            if bucket is None:
+                index[word] = word
+            elif type(bucket) is str:
+                index[word] = [bucket, word]
+            else:
+                bucket.append(word)
+            # one deletion: every string that becomes `word` once a character is added back
+            for i in range(len(word)):
+                key = word[:i] + word[i + 1 :]
+                bucket = get(key)
+                if bucket is None:
+                    index[key] = word
+                elif type(bucket) is str:
+                    index[key] = [bucket, word]
+                else:
+                    bucket.append(word)
+        self._delete_index = index
+        return index
+
