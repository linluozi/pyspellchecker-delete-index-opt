+    @staticmethod
+    def __is_within_one_edit(left: str, right: str) -> bool:
+        """Check whether two strings are at most one edit apart, counting an adjacent
+        transposition as a single edit (Damerau-Levenshtein distance of one)
+
+        Args:
+            left (str): The first string
+            right (str): The second string
+        Returns:
+            bool: True if a single delete, insert, substitute or transposition turns
+                `left` into `right`"""
+        len_left = len(left)
+        len_right = len(right)
+        if len_left == len_right:
+            if left == right:
+                return True
+            first = -1
+            second = -1
+            for i in range(len_left):
+                if left[i] != right[i]:
+                    if first < 0:
+                        first = i
+                    elif second < 0:
+                        second = i
+                    else:
+                        return False
+            # a single substitution, or a swap of two neighbouring characters
+            return second < 0 or (second == first + 1 and left[first] == right[second] and left[second] == right[first])
+        if len_left + 1 == len_right:
+            return SpellChecker.__is_one_deletion(right, left)
+        if len_right + 1 == len_left:
+            return SpellChecker.__is_one_deletion(left, right)
+        return False
+
+    @staticmethod
+    def __is_one_deletion(longer: str, shorter: str) -> bool:
+        """Check whether `shorter` is `longer` with exactly one character removed"""
+        i = 0
+        for char in longer:
+            if i < len(shorter) and char == shorter[i]:
+                i += 1
+        return i == len(shorter) and len(longer) - len(shorter) == 1
 
